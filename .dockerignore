# Only used for `deploy/render-single/Dockerfile` (build context = repo root).
# backend/ and frontend/ have their own .dockerignore for their docker-compose
# builds (this file doesn't affect those).

.git
.gitignore
.DS_Store
*.log
.vscode
.idea

.venv
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/**/*.pyc
backend/db.sqlite3
backend/media/
backend/staticfiles/
backend/.env
backend/.env.*

frontend/node_modules
frontend/.next
frontend/.env*
!frontend/.env.local.example

frontend_html_reference
