# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=True

# Database (leave DB_ENGINE empty for SQLite, set to django.db.backends.postgresql for PostgreSQL)
DB_ENGINE=
DB_NAME=goldensunlight_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
ALLOWED_HOSTS=*,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80,http://127.0.0.1,http://127.0.0.1:3000

# Admin support "suggest a reply" (support/ai.py) — optional, feature is disabled
# (returns 503) if left empty. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
SUPPORT_AI_MODEL=claude-opus-5
