# docker-compose.yml shu fayldan (.env nomi bilan, shu papkada) qiymatlarni o'qiydi.
# Nusxa oling: cp .env.example .env — so'ng PASTDAGI HAMMA QIYMATNI HAQIQIYSIGA ALMASHTIRING.
# .env fayli gitga HECH QACHON qo'shilmaydi (.gitignore'da allaqachon bor).

# Django maxfiy kaliti — quyidagi buyruq bilan generatsiya qiling:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# PostgreSQL — kuchli, tasodifiy parol qo'ying (masalan: openssl rand -base64 24)
DB_NAME=goldensunlight_db
DB_USER=postgres
DB_PASSWORD=

# Domeningiz yoki server IP manzili (vergul bilan, bo'sh joysiz)
# Masalan: ALLOWED_HOSTS=goldensunlight.uz,www.goldensunlight.uz
# Domen hali yo'q bo'lsa, vaqtincha: ALLOWED_HOSTS=<EC2_PUBLIC_IP>
ALLOWED_HOSTS=

# Xuddi shu domen(lar), lekin https:// bilan, vergul bilan ajratilgan
# Masalan: CORS_ALLOWED_ORIGINS=https://goldensunlight.uz,https://www.goldensunlight.uz
CORS_ALLOWED_ORIGINS=

# Sayt to'liq manzili (frontend shu asosda mutlaq havolalar/metadata yaratadi)
# Masalan: SITE_URL=https://goldensunlight.uz
SITE_URL=

# Admin support panelidagi "AI taklif" tugmasi uchun (backend/support/ai.py) —
# ixtiyoriy, bo'sh qolsa bu funksiya shunchaki o'chiq turadi (503 qaytaradi).
# Kalitni console.anthropic.com orqali olasiz.
ANTHROPIC_API_KEY=

# Email verification codes (backend/users/tasks.py), sent by the `celery` worker
# service. Leave EMAIL_HOST_USER empty and the code is just logged to the celery
# container's console instead of actually being emailed. Defaults below are for
# mail.ru — EMAIL_HOST_PASSWORD must be an app password (Settings > Password and
# security > Password for external apps in mail.ru), not the account's login
# password.
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
